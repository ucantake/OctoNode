{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OctoNode",
  "version": "0.1.0",
  "identifier": "dev.octonode.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "OctoNode",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 600,
        "theme": "Dark",
        "backgroundColor": "#0b0d12"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: https://avatars.githubusercontent.com https://secure.gravatar.com https://gitlab.com; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Multi-account Git client",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": { "depends": ["git"] }
    },
    "macOS": { "minimumSystemVersion": "10.15" },
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" }
    }
  }
}
